# Copie para .env (local) ou configure como variáveis de ambiente na Railway/Vercel.

# Chave da API do Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# OBRIGATÓRIA. Nunca commitar. Nunca expor no frontend.
GEMINI_API_KEY=

# Modelo de geração de imagem do Gemini.
# gemini-2.5-flash-image      = rápido e barato
# gemini-3-pro-image-preview  = melhor fidelidade de rosto e do texto da camiseta (padrão)
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Porta do servidor (a Railway injeta automaticamente; ignorado na Vercel)
PORT=3000

# Origem permitida no CORS. Use o domínio do front se ele estiver separado da API.
CORS_ORIGIN=*

# Limite de requisições por IP por hora (proteção básica contra abuso)
RATE_LIMIT_PER_HOUR=20

# Modo mock: devolve uma imagem fixa sem chamar o Gemini (1 = ligado)
MOCK=0
