# Copie para .env (local) ou configure como variáveis de ambiente na Railway/Vercel.

# Chave da API do Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# OBRIGATÓRIA. Nunca commitar. Nunca expor no frontend.
GEMINI_API_KEY=

# Modelo de geração de imagem do Gemini.
# gemini-2.5-flash-image      = rápido e barato
# gemini-3-pro-image-preview  = melhor fidelidade de rosto e do texto da camiseta (padrão)
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Porta do servidor (a Railway injeta automaticamente; ignorado na Vercel)
PORT=3000

# Origem permitida no CORS. Use o domínio do front se ele estiver separado da API.
CORS_ORIGIN=*

# Chamadas simultâneas ao Gemini. Acima disso, as requisições entram numa fila.
# A API fica MUITO mais lenta com várias em paralelo na mesma chave: medimos 20s
# isolada contra 84-91s com três ao mesmo tempo. 2 mantém cada geração em ~20s.
GEMINI_CONCURRENCY=2

# Intervalo mínimo entre duas gerações do mesmo IP, em segundos. Num evento com wifi
# compartilhado todo mundo sai pelo mesmo IP, então isto é um anti-spam curto e não
# uma cota — uma cota por IP trancaria o local inteiro. 0 desliga.
COOLDOWN_IP_S=15

# Teto de gerações por hora no app inteiro. Guarda de orçamento, conta tentativas.
LIMITE_GLOBAL_HORA=300

# Modo mock: devolve uma imagem fixa sem chamar o Gemini (1 = ligado)
MOCK=0

# Mural de resultados: 1 grava cada imagem gerada em backend/galeria/ e alimenta o
# mosaico no fim do site. 0 desliga a gravação e o mural some da página.
GALERIA=1

# Token para remover uma imagem do mural (DELETE /api/galeria/<id> com header
# x-admin-token). Em branco = rota desativada. Defina antes de abrir ao público:
# é a única forma de atender alguém que peça para sair do mural.
ADMIN_TOKEN=
